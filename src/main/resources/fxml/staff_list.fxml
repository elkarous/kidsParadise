<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.kindererp.controller.StaffListController" spacing="12">
    <padding>
        <Insets top="12"/>
    </padding>

    <HBox styleClass="toolbar">
        <TextField fx:id="searchField" promptText="%staff.search" HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="salaryTypeFilter" prefWidth="200" promptText="%staff.salaryType"/>
        <CheckBox fx:id="showInactiveCheck" text="%staff.showInactive"/>
        <Button fx:id="addButton" text="%staff.add" onAction="#handleAdd" styleClass="btn-primary"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nameColumn" text="%staff.name" prefWidth="220"/>
            <TableColumn fx:id="positionColumn" text="%staff.position" prefWidth="180"/>
            <TableColumn fx:id="phoneColumn" text="%staff.phone" prefWidth="130"/>
            <TableColumn fx:id="salaryTypeColumn" text="%staff.salaryType" prefWidth="170"/>
            <TableColumn fx:id="salaryColumn" text="%staff.baseSalary" prefWidth="140"/>
            <TableColumn fx:id="statusColumn" text="%staff.status" prefWidth="120"/>
            <TableColumn fx:id="deleteColumn" prefWidth="60" minWidth="60" maxWidth="60"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
    </TableView>
</VBox>
