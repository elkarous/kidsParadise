<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.kindererp.controller.StaffAttendanceController" styleClass="page">
    <VBox>
        <Label text="%staffAttendance.title" styleClass="page-title"/>
        <Label text="%staffAttendance.subtitle" styleClass="page-subtitle"/>
    </VBox>
    <HBox styleClass="toolbar">
        <Label text="%attendance.date" styleClass="field-label"/>
        <DatePicker fx:id="datePicker" prefWidth="170"/>
    </HBox>
    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <Tab fx:id="teachersTab" text="%staff.teachers"/>
        <Tab fx:id="employeesTab" text="%staff.employees"/>
    </TabPane>
</VBox>
