<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.kids.ui.ParentFormController" style="-fx-background-color: white;"
      prefWidth="400.0" prefHeight="350.0">

    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <GridPane vgap="10.0" hgap="10.0" VBox.vgrow="ALWAYS">
        <columnConstraints>
            <ColumnConstraints minWidth="100.0" prefWidth="120.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
        </columnConstraints>

        <Label text="%parent.fatherName" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <TextField fx:id="txtFatherName" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-background-radius: 5;"/>

        <Label text="%parent.motherName" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <TextField fx:id="txtMotherName" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-background-radius: 5;"/>

        <Label text="%parent.phone" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <TextField fx:id="txtPhone" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-background-radius: 5;"/>

        <Label text="%parent.email" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <TextField fx:id="txtEmail" GridPane.rowIndex="3" GridPane.columnIndex="1" style="-fx-background-radius: 5;"/>
    </GridPane>

    <HBox spacing="10.0" alignment="CENTER_RIGHT">
        <Button fx:id="btnCancel" text="%btn.cancel" onAction="#handleCancel" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" prefWidth="80.0"/>
        <Button fx:id="btnSave" text="%btn.save" onAction="#handleSave" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" prefWidth="80.0"/>
    </HBox>
</VBox>