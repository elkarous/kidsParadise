<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.kindererp.controller.UsersController" spacing="16">
    <padding>
        <Insets top="16"/>
    </padding>

    <VBox spacing="12" HBox.hgrow="ALWAYS">
        <TableView fx:id="table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="usernameColumn" text="%login.username" prefWidth="180"/>
                <TableColumn fx:id="fullNameColumn" text="%users.fullName" prefWidth="220"/>
                <TableColumn fx:id="activeColumn" text="%staff.status" prefWidth="120"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
        </TableView>
        <HBox styleClass="button-bar">
            <Button text="%btn.delete" onAction="#handleDelete" styleClass="btn-danger"/>
            <Button text="%users.toggleActive" onAction="#handleToggleActive"/>
            <Button text="%users.resetPassword" onAction="#handleResetPassword"/>
        </HBox>
    </VBox>

    <VBox styleClass="card" spacing="10" prefWidth="320" minWidth="300">
        <Label text="%users.add" styleClass="section-title"/>
        <Label text="%login.username" styleClass="field-label"/>
        <TextField fx:id="usernameField"/>
        <Label text="%users.fullName" styleClass="field-label"/>
        <TextField fx:id="fullNameField"/>
        <Label text="%login.password" styleClass="field-label"/>
        <PasswordField fx:id="passwordField"/>
        <Label text="%users.passwordConfirm" styleClass="field-label"/>
        <PasswordField fx:id="passwordConfirmField"/>
        <Button fx:id="addButton" text="%btn.add" onAction="#handleAdd" styleClass="btn-primary" maxWidth="Infinity"/>
    </VBox>
</HBox>
