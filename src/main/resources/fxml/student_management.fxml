<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #F8FAFC;" stylesheets="@/styles/modern-ui.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kids.ui.StudentController">
    <children>
        <VBox spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
            </padding>
            <children>

                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <VBox HBox.hgrow="ALWAYS">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-font-size: 24px; -fx-text-fill: #0F172A;" text="%nav.student" />
                                <Label style="-fx-font-size: 13px; -fx-text-fill: #64748B;" text="إدارة بيانات الطلاب، الحسابات، وتوزيع الأقسام" />
                            </children>
                        </VBox>
                        <Button mnemonicParsing="false" onAction="#handleAddNewStudent" styleClass="btn-primary" text="➕ إضافة طالب جديد">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </Button>
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: white; -fx-padding: 12 20; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;">
                    <children>
                        <TextField fx:id="txtStudentSearch" prefHeight="38.0" promptText="🔍 ابحث عن طالب بالاسم، اللقب أو الولي..." styleClass="modern-text-field" HBox.hgrow="ALWAYS" />

                        <ComboBox fx:id="comboFilterLevel" prefHeight="38.0" prefWidth="150.0" promptText="المستوى" styleClass="modern-combo-box" />

                        <ComboBox fx:id="comboFilterClass" prefHeight="38.0" prefWidth="150.0" promptText="القسم" styleClass="modern-combo-box" />
                    </children>
                </HBox>

                <SplitPane style="-fx-background-color: transparent;" styleClass="modern-split-pane" VBox.vgrow="ALWAYS">
                    <items>
                        <AnchorPane style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-padding: 10;">
                            <children>
                                <VBox spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                                    <children>
                                        <TableView fx:id="studentTable" styleClass="modern-table" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="colAction" maxWidth="90.0" minWidth="90.0" prefWidth="90.0" resizable="false" sortable="false" text="إجراءات" />
                                                <TableColumn fx:id="colName" prefWidth="180.0" text="%firstName" />
                                                <TableColumn fx:id="colLevel" prefWidth="120.0" text="%level" />
                                                <TableColumn fx:id="colClass" prefWidth="120.0" text="%class" />
                                                <TableColumn fx:id="colParent" prefWidth="180.0" text="%parent" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>
                                    </children>
                                </VBox>
                            </children>
                        </AnchorPane>

                    </items>
                </SplitPane>
            </children>
        </VBox>
    </children>
</AnchorPane>
