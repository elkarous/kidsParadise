<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kids.ui.StudentController">
    <children>
        <VBox spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <!-- Header Section -->
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label text="%nav.student">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>

                <!-- Main Content Area -->
                <SplitPane dividerPositions="0.65" VBox.vgrow="ALWAYS">
                    <items>
                        <!-- LEFT SIDE: Table Section -->
                        <AnchorPane>
                            <children>
                                <VBox spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                                    <children>
                                        <TableView fx:id="studentTable" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="colName" prefWidth="150.0" text="Full Name" />
                                                <TableColumn fx:id="colLevel" prefWidth="100.0" text="Level" />
                                                <TableColumn fx:id="colClass" prefWidth="100.0" text="Class" />
                                                <TableColumn fx:id="colParent" prefWidth="150.0" text="Parent" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>
                                    </children>
                                </VBox>
                            </children>
                        </AnchorPane>

                        <!-- RIGHT SIDE: Management Form -->
                        <AnchorPane minWidth="280.0">
                            <children>
                                <VBox spacing="20.0" style="-fx-background-color: #f4f4f4; -fx-background-radius: 10;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                                    <padding>
                                        <Insets bottom="20.0" left="15.0" right="15.0" top="20.0" />
                                    </padding>
                                    <children>
                                        <Label text="Student Details" textFill="#2c3e50">
                                            <font>
                                                <Font name="System Bold" size="18.0" />
                                            </font>
                                        </Label>

                                        <VBox spacing="5.0">
                                            <children>
                                                <Label text="Full Name" />
                                                <TextField fx:id="txtName" promptText="Enter student name" style="-fx-background-radius: 5;" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="5.0">
                                            <children>
                                                <Label text="Level" />
                                                <ComboBox fx:id="comboLevel" maxWidth="1.7976931348623157E308" promptText="Select Level" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="5.0">
                                            <children>
                                                <Label text="Class" />
                                                <ComboBox fx:id="comboClass" maxWidth="1.7976931348623157E308" promptText="Select Class" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="5.0">
                                            <children>
                                                <Label text="Parent" />
                                                <ComboBox fx:id="comboParent" maxWidth="1.7976931348623157E308" promptText="Select Parent" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                                            <children>
                                                <Button fx:id="btnSave" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onSave" prefHeight="35.0" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Save / Update" />
                                                <Button fx:id="btnDelete" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onDelete" prefHeight="35.0" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Delete" />
                                            </children>
                                            <padding>
                                                <Insets top="10.0" />
                                            </padding>
                                        </VBox>
                                    </children>
                                </VBox>
                            </children>
                        </AnchorPane>
                    </items>
                </SplitPane>
            </children>
        </VBox>
    </children>
</AnchorPane>