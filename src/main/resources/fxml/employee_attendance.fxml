<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<TabPane prefHeight="750.0" prefWidth="1150.0" style="-fx-background-color: #F8FAFC;" stylesheets="@/styles/modern-ui.css" tabClosingPolicy="UNAVAILABLE" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kids.ui.EmployeeAttendanceController">
    <tabs>
        <Tab text="حضور الأساتذة / Teachers Attendance">
            <content>
                <AnchorPane>
                    <children>
                        <HBox spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                            </padding>
                            <children>
                                <TableView fx:id="teacherAttendanceTable" styleClass="modern-table" HBox.hgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colTeacherAttendName" prefWidth="250.0" text="%teacher.name" />
                                        <TableColumn fx:id="colTeacherAttendStatus" prefWidth="150.0" style="-fx-alignment: CENTER;" text="%admin.status" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>

                                <VBox prefWidth="400.0" spacing="15.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 12;">
                                    <children>
                                        <Label style="-fx-font-weight: 800; -fx-font-size: 16px; -fx-text-fill: #0F172A;" text="تسجيل حضور الأساتذة" />
                                        <Separator />
                                        <VBox spacing="6.0">
                                            <children>
                                                <Label styleClass="field-label" text="%attendance.date" />
                                                <DatePicker fx:id="teacherAttendanceDatePicker" maxWidth="1.7976931348623157E308" prefHeight="40.0" styleClass="modern-text-field" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="8.0">
                                            <children>
                                                <Label styleClass="field-label" text="حالة الحضور اليومية:" />
                                                <HBox spacing="10.0" style="-fx-padding: 5 0;">
                                                    <children>
                                                        <RadioButton fx:id="rbTeacherPresent" mnemonicParsing="false" text="%attendance.present">
                                                            <toggleGroup><ToggleGroup fx:id="teacherAttendanceToggleGroup" /></toggleGroup>
                                                        </RadioButton>
                                                        <RadioButton fx:id="rbTeacherAbsent" mnemonicParsing="false" text="%attendance.absent" toggleGroup="$teacherAttendanceToggleGroup" />
                                                        <RadioButton fx:id="rbTeacherLate" mnemonicParsing="false" text="%attendance.late" toggleGroup="$teacherAttendanceToggleGroup" />
                                                        <RadioButton fx:id="rbTeacherExcused" mnemonicParsing="false" text="%attendance.excused" toggleGroup="$teacherAttendanceToggleGroup" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                        <VBox fx:id="paneTeacherSessions" spacing="6.0">
                                            <children>
                                                <Label styleClass="field-label" text="عدد الحصص المنجزة (خاص بالأستاذ بالجلسة):" />
                                                <Spinner fx:id="teacherSessionsSpinner" maxWidth="1.7976931348623157E308" prefHeight="40.0" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="6.0" VBox.vgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="field-label" text="%payment.notes" />
                                                <TextArea fx:id="teacherAttendanceNotes" prefHeight="100.0" promptText="ملاحظات الحضور..." styleClass="modern-text-field" />
                                            </children>
                                        </VBox>
                                        <Button fx:id="btnMarkTeacherAttendance" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleMarkTeacherAttendance" prefHeight="45.0" styleClass="btn-primary" text="حفظ حضور الأستاذ">
                                            <cursor><Cursor fx:constant="HAND" /></cursor>
                                        </Button>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </AnchorPane>
            </content>
        </Tab>

        <Tab text="حضور الإداريين والعملة / Staff Attendance">
            <content>
                <AnchorPane>
                    <children>
                        <HBox spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                            </padding>
                            <children>
                                <TableView fx:id="employeeAttendanceTable" styleClass="modern-table" HBox.hgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colEmployeeAttendName" prefWidth="250.0" text="%admin.name" />
                                        <TableColumn fx:id="colEmployeeAttendStatus" prefWidth="150.0" style="-fx-alignment: CENTER;" text="%admin.status" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>

                                <VBox prefWidth="400.0" spacing="15.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 12;">
                                    <children>
                                        <Label style="-fx-font-weight: 800; -fx-font-size: 16px; -fx-text-fill: #0F172A;" text="تسجيل حضور الإداريين والعملة" />
                                        <Separator />
                                        <VBox spacing="6.0">
                                            <children>
                                                <Label styleClass="field-label" text="%attendance.date" />
                                                <DatePicker fx:id="employeeAttendanceDatePicker" maxWidth="1.7976931348623157E308" prefHeight="40.0" styleClass="modern-text-field" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="8.0">
                                            <children>
                                                <Label styleClass="field-label" text="حالة الحضور اليومية:" />
                                                <HBox spacing="10.0" style="-fx-padding: 5 0;">
                                                    <children>
                                                        <RadioButton fx:id="rbEmployeePresent" mnemonicParsing="false" text="%attendance.present">
                                                            <toggleGroup><ToggleGroup fx:id="employeeAttendanceToggleGroup" /></toggleGroup>
                                                        </RadioButton>
                                                        <RadioButton fx:id="rbEmployeeAbsent" mnemonicParsing="false" text="%attendance.absent" toggleGroup="$employeeAttendanceToggleGroup" />
                                                        <RadioButton fx:id="rbEmployeeLate" mnemonicParsing="false" text="%attendance.late" toggleGroup="$employeeAttendanceToggleGroup" />
                                                        <RadioButton fx:id="rbEmployeeExcused" mnemonicParsing="false" text="%attendance.excused" toggleGroup="$employeeAttendanceToggleGroup" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                        <VBox spacing="6.0" VBox.vgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="field-label" text="%payment.notes" />
                                                <TextArea fx:id="employeeAttendanceNotes" prefHeight="100.0" promptText="ملاحظات حضور الموظف..." styleClass="modern-text-field" />
                                            </children>
                                        </VBox>
                                        <Button fx:id="btnMarkEmployeeAttendance" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleMarkEmployeeAttendance" prefHeight="45.0" styleClass="btn-primary" text="حفظ حضور الموظف">
                                            <cursor><Cursor fx:constant="HAND" /></cursor>
                                        </Button>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </AnchorPane>
            </content>
        </Tab>
    </tabs>
</TabPane>