<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<TabPane prefHeight="750.0" prefWidth="1200.0" style="-fx-background-color: #F8FAFC;" stylesheets="@/styles/modern-ui.css" tabClosingPolicy="UNAVAILABLE" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kids.ui.EmployeeAttendanceController">
    <tabs>
        <Tab text="%nav.teachers.attendance">
            <content>
                <AnchorPane>
                    <children>
                        <VBox spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                            </padding>
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-padding: 12 20; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10;">
                                    <children>
                                        <Label style="-fx-font-weight: bold; -fx-text-fill: #334155;" text="%attendance.date" />
                                        <DatePicker fx:id="teacherAttendanceDatePicker" onAction="#handleTeacherDateChanged" prefHeight="38.0" styleClass="modern-text-field" />
                                        <Label style="-fx-text-fill: #64748B; -fx-font-size: 13px;" text="%attendance.date.hint" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Button mnemonicParsing="false" onAction="#handleSaveAllTeachersAttendance" prefHeight="40.0" prefWidth="180.0" styleClass="btn-primary" text="%attendance.save.all">
                                            <cursor><Cursor fx:constant="HAND" /></cursor>
                                        </Button>
                                    </children>
                                </HBox>

                                <TableView fx:id="teacherAttendanceTable" styleClass="modern-table" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colTeacherAttendName" prefWidth="200.0" text="%teacher.name" />
                                        <TableColumn fx:id="colTeacherActionStatus" prefWidth="280.0" style="-fx-alignment: CENTER;" text="%attendance.status.column" />
                                        <TableColumn fx:id="colTeacherCheckIn" prefWidth="120.0" style="-fx-alignment: CENTER;" text="وقت الدخول" />
                                        <TableColumn fx:id="colTeacherCheckOut" prefWidth="120.0" style="-fx-alignment: CENTER;" text="وقت الخروج" />
                                        <TableColumn fx:id="colTeacherNotes" prefWidth="250.0" text="%payment.notes" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </AnchorPane>
            </content>
        </Tab>

        <Tab text="%nav.employees.attendance">
            <content>
                <AnchorPane>
                    <children>
                        <VBox spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                            </padding>
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-padding: 12 20; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10;">
                                    <children>
                                        <Label style="-fx-font-weight: bold; -fx-text-fill: #334155;" text="%attendance.date" />
                                        <DatePicker fx:id="employeeAttendanceDatePicker" onAction="#handleEmployeeDateChanged" prefHeight="38.0" styleClass="modern-text-field" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Button mnemonicParsing="false" onAction="#handleSaveAllEmployeesAttendance" prefHeight="40.0" prefWidth="180.0" styleClass="btn-primary" text="%attendance.save.all">
                                            <cursor><Cursor fx:constant="HAND" /></cursor>
                                        </Button>
                                    </children>
                                </HBox>

                                <TableView fx:id="employeeAttendanceTable" styleClass="modern-table" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colEmployeeAttendName" prefWidth="200.0" text="%admin.name" />
                                        <TableColumn fx:id="colEmployeeActionStatus" prefWidth="280.0" style="-fx-alignment: CENTER;" text="%attendance.status.column" />
                                        <TableColumn fx:id="colEmployeeCheckIn" prefWidth="120.0" style="-fx-alignment: CENTER;" text="وقت الدخول" />
                                        <TableColumn fx:id="colEmployeeCheckOut" prefWidth="120.0" style="-fx-alignment: CENTER;" text="وقت الخروج" />
                                        <TableColumn fx:id="colEmployeeNotes" prefWidth="250.0" text="%payment.notes" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </AnchorPane>
            </content>
        </Tab>
    </tabs>
</TabPane>