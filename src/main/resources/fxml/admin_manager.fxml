<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.layout.Region?>
<TabPane prefHeight="750.0" prefWidth="1100.0" tabClosingPolicy="UNAVAILABLE"
         style="-fx-background-color: #F8FAFC;"
         stylesheets="@/styles/modern-ui.css"
         xmlns="http://javafx.com/javafx/21"
         xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="com.kids.ui.AdminManagerController">
<Tab text="%nav.admins">
    <AnchorPane>
        <VBox spacing="18.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>

            <!-- شريط البحث -->
            <HBox alignment="CENTER_LEFT" spacing="15.0">
                <children>
                    <TextField fx:id="searchField" prefHeight="40.0" prefWidth="350.0"
                               promptText="%btn.search" styleClass="modern-text-field"/>
                </children>
            </HBox>

            <!-- جدول الإداريين -->
            <TableView fx:id="adminTable" styleClass="modern-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colName" prefWidth="200.0" text="%admin.name"/>
                    <TableColumn fx:id="colRole" prefWidth="150.0" text="%admin.role"/>
                    <TableColumn fx:id="colSalary" prefWidth="150.0" text="%admin.salary"/>
                    <TableColumn fx:id="colStatus" prefWidth="120.0" style="-fx-alignment: CENTER;"
                                 text="%admin.status"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <!-- فورمة الإدخال والتعديل -->
            <VBox spacing="15.0"
                  style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 12;">
                <children>
                    <HBox spacing="15.0">
                        <children>
                            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                <children>
                                    <Label styleClass="field-label" text="%admin.name"/>
                                    <TextField fx:id="txtAdminName" prefHeight="40.0"
                                               styleClass="modern-text-field"/>
                                </children>
                            </VBox>
                            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                <children>
                                    <Label styleClass="field-label" text="%admin.role"/>
                                    <TextField fx:id="txtRole" prefHeight="40.0"
                                               styleClass="modern-text-field"/>
                                </children>
                            </VBox>
                            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                <children>
                                    <Label styleClass="field-label" text="%admin.salary"/>
                                    <TextField fx:id="txtSalary" prefHeight="40.0"
                                               styleClass="modern-text-field"/>
                                </children>
                            </VBox>
                            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                <children>
                                    <Label styleClass="field-label" text="%admin.status"/>
                                    <ComboBox fx:id="cbStatusForm" maxWidth="1.7976931348623157E308"
                                              prefHeight="40.0" styleClass="modern-combo-box"/>
                                </children>
                            </VBox>
                        </children>
                    </HBox>

                    <!-- تفاصيل ثانوية مثل الهاتف والإيميل والتعيين -->
                    <HBox spacing="15.0">
                        <children>
                            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                <children>
                                    <Label styleClass="field-label" text="%admin.phone"/>
                                    <TextField fx:id="txtPhone" prefHeight="40.0"
                                               styleClass="modern-text-field"/>
                                </children>
                            </VBox>
                            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                <children>
                                    <Label styleClass="field-label" text="%admin.email"/>
                                    <TextField fx:id="txtEmail" prefHeight="40.0"
                                               styleClass="modern-text-field"/>
                                </children>
                            </VBox>
                            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                <children>
                                    <Label styleClass="field-label" text="%admin.hiring.date"/>
                                    <DatePicker fx:id="dpHiringDate" maxWidth="1.7976931348623157E308"
                                                prefHeight="40.0" styleClass="modern-text-field"/>
                                </children>
                            </VBox>
                        </children>
                    </HBox>

                    <!-- أزرار العمليات -->
                    <HBox alignment="CENTER_RIGHT" spacing="12.0">
                        <children>
                            <Button mnemonicParsing="false" onAction="#handleDeleteAdmin"
                                    prefHeight="40.0" prefWidth="95.0" styleClass="btn-danger"
                                    text="%btn.delete">
                                <cursor>
                                    <Cursor fx:constant="HAND"/>
                                </cursor>
                            </Button>
                            <Button mnemonicParsing="false" onAction="#handleUpdateAdmin"
                                    prefHeight="40.0" prefWidth="100.0" styleClass="btn-secondary"
                                    text="%btn.update">
                                <cursor>
                                    <Cursor fx:constant="HAND"/>
                                </cursor>
                            </Button>
                            <Button mnemonicParsing="false" onAction="#handleAddAdmin"
                                    prefHeight="40.0" prefWidth="105.0" styleClass="btn-primary"
                                    text="%btn.add">
                                <cursor>
                                    <Cursor fx:constant="HAND"/>
                                </cursor>
                            </Button>
                        </children>
                    </HBox>
                </children>
            </VBox>
        </VBox>
    </AnchorPane>
</Tab>

        <!-- التبويب الثاني: الحضور والانصراف -->
<Tab text="%attendance.mark">
<content>
    <AnchorPane>
        <children>
            <HBox spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                  AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                </padding>
                <children>
                    <TableView fx:id="adminAttendanceTable" prefWidth="450.0" styleClass="modern-table"
                               HBox.hgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colAttendName" prefWidth="250.0" text="%admin.name"/>
                            <TableColumn fx:id="colAttendStatus" prefWidth="150.0"
                                         style="-fx-alignment: CENTER;" text="%admin.status"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>

                    <VBox prefWidth="420.0" spacing="15.0"
                          style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 12;">
                        <children>
                            <Label style="-fx-font-weight: 800; -fx-font-size: 16px; -fx-text-fill: #0F172A;"
                                   text="%attendance.mark"/>
                            <Separator/>

                            <VBox spacing="6.0">
                                <children>
                                    <Label styleClass="field-label" text="%attendance.date"/>
                                    <DatePicker fx:id="attendanceDatePicker" maxWidth="1.7976931348623157E308"
                                                prefHeight="40.0" styleClass="modern-text-field"/>
                                </children>
                            </VBox>

                            <VBox spacing="8.0">
                                <children>
                                    <Label styleClass="field-label" text="%admin.status"/>
                                    <HBox spacing="10.0" style="-fx-padding: 5 0;">
                                        <children>
                                            <RadioButton fx:id="rbPresent" mnemonicParsing="false"
                                                         text="%attendance.present">
                                                <toggleGroup>
                                                    <ToggleGroup fx:id="attendanceToggleGroup"/>
                                                </toggleGroup>
                                            </RadioButton>
                                            <RadioButton fx:id="rbAbsent" mnemonicParsing="false"
                                                         text="%attendance.absent"
                                                         toggleGroup="$attendanceToggleGroup"/>
                                            <RadioButton fx:id="rbLate" mnemonicParsing="false"
                                                         text="%attendance.late"
                                                         toggleGroup="$attendanceToggleGroup"/>
                                            <RadioButton fx:id="rbExcused" mnemonicParsing="false"
                                                         text="%attendance.excused"
                                                         toggleGroup="$attendanceToggleGroup"/>
                                        </children>
                                    </HBox>
                                </children>
                            </VBox>

                            <!-- عدد الجلسات أو ساعات العمل الفعالة -->
                            <VBox spacing="6.0">
                                <children>
                                    <Label styleClass="field-label" text="%attendance.sessions"/>
                                    <Spinner fx:id="sessionsSpinner" maxWidth="1.7976931348623157E308"
                                             prefHeight="40.0"/>
                                </children>
                            </VBox>

                            <VBox spacing="6.0" VBox.vgrow="ALWAYS">
                                <children>
                                    <Label styleClass="field-label" text="%payment.notes"/>
                                    <TextArea fx:id="attendanceNotes" prefHeight="80.0" promptText="..."
                                              styleClass="modern-text-field"/>
                                </children>
                            </VBox>

                            <Button fx:id="btnMarkAttendance" maxWidth="1.7976931348623157E308"
                                    mnemonicParsing="false" onAction="#handleMarkAttendance" prefHeight="42.0"
                                    styleClass="btn-primary" text="%attendance.mark">
                                <cursor>
                                    <Cursor fx:constant="HAND"/>
                                </cursor>
                            </Button>
                        </children>
                    </VBox>
                </children>
            </HBox>
        </children>
    </AnchorPane>
</content>
</Tab>

        <!-- التبويب الثالث: صرف الرواتب للموظفين الإداريين -->
<Tab text="%payroll.pay.now">
<content>
    <AnchorPane>
        <children>
            <HBox spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                  AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                </padding>
                <children>
                    <TableView fx:id="adminPayrollTable" prefWidth="450.0" styleClass="modern-table"
                               HBox.hgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colPayrollName" prefWidth="230.0" text="%admin.name"/>
                            <TableColumn fx:id="colPayrollPending" prefWidth="170.0"
                                         style="-fx-alignment: CENTER; -fx-text-fill: #DC2626;"
                                         text="%salary.pending"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>

                    <VBox prefWidth="420.0" spacing="15.0"
                          style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #DEF7EC; -fx-border-radius: 12;">
                        <children>
                            <Label style="-fx-font-weight: 800; -fx-font-size: 16px; -fx-text-fill: #0F172A;"
                                   text="%report.title.admin"/>
                            <Separator/>

                            <!-- المنطقة المالية للحسابات الاستباقية للرواتب -->
                            <VBox spacing="10.0"
                                  style="-fx-background-color: #F8FAFC; -fx-padding: 15; -fx-background-radius: 10;">
                                <children>
                                    <HBox alignment="CENTER_LEFT">
                                        <children>
                                            <Label style="-fx-text-fill: #64748B; -fx-font-size: 13px;"
                                                   text="%payroll.gross"/>
                                            <Region HBox.hgrow="ALWAYS"/>
                                            <Label fx:id="lblGrossSalary"
                                                   style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #0F172A;"
                                                   text="0.0"/>
                                        </children>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT">
                                        <children>
                                            <Label style="-fx-text-fill: #64748B; -fx-font-size: 13px;"
                                                   text="%payroll.paid"/>
                                            <Region HBox.hgrow="ALWAYS"/>
                                            <Label fx:id="lblPaid"
                                                   style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #16A34A;"
                                                   text="0.0"/>
                                        </children>
                                    </HBox>
                                    <Separator/>
                                    <HBox alignment="CENTER_LEFT">
                                        <children>
                                            <Label style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #DC2626;"
                                                   text="%payroll.pending"/>
                                            <Region HBox.hgrow="ALWAYS"/>
                                            <Label fx:id="lblPending"
                                                   style="-fx-font-weight: 900; -fx-font-size: 16px; -fx-text-fill: #DC2626;"
                                                   text="0.0"/>
                                        </children>
                                    </HBox>
                                </children>
                            </VBox>

                            <!-- حقول عملية الصرف السريع والآمن -->
                            <VBox spacing="12.0">
                                <children>
                                    <VBox spacing="5.0">
                                        <children>
                                            <Label styleClass="field-label" text="%salary"/>
                                            <TextField fx:id="txtPayAmount" prefHeight="40.0" promptText="0.00"
                                                       styleClass="modern-text-field"/>
                                        </children>
                                    </VBox>

                                    <VBox spacing="5.0">
                                        <children>
                                            <Label styleClass="field-label" text="%payroll.payment.method"/>
                                            <ComboBox fx:id="cbPaymentMethod" maxWidth="1.7976931348623157E308"
                                                      prefHeight="40.0" styleClass="modern-combo-box"/>
                                        </children>
                                    </VBox>

                                    <VBox spacing="5.0">
                                        <children>
                                            <Label styleClass="field-label" text="%payroll.reference"/>
                                            <TextField fx:id="txtReference" prefHeight="40.0"
                                                       styleClass="modern-text-field"/>
                                        </children>
                                    </VBox>
                                </children>
                            </VBox>

                            <Button fx:id="btnPayNow" maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                                    onAction="#handlePayNow" prefHeight="42.0" styleClass="btn-success"
                                    text="%payroll.pay.now">
                                <cursor>
                                    <Cursor fx:constant="HAND"/>
                                </cursor>
                            </Button>
                        </children>
                    </VBox>
                </children>
            </HBox>
        </children>
    </AnchorPane>
</content>
</Tab>
</TabPane>