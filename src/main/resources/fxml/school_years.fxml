<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" style="-fx-padding: 20; -fx-background-color: #f8f9fa;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kids.ui.SchoolYearController">

    <Label text="إدارة السنوات الدراسية" style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #4A5568;"/>

    <HBox spacing="10.0" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;">
        <TextField fx:id="txtYearName" promptText="مثال: 2026-2027" prefWidth="200.0"/>
        <Button text="إطلاق السنة وتوليد الأشهر تلقائياً" onAction="#handleCreateYear" style="-fx-background-color: #4c51bf; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>

    <TableView fx:id="yearTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="60.0" text="ID"/>
            <TableColumn fx:id="colYearName" prefWidth="250.0" text="السنة الدراسية"/>
            <TableColumn fx:id="colStatus" prefWidth="150.0" text="الحالة"/>
        </columns>
    </TableView>
</VBox>