<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="650.0" minWidth="1000.0" stylesheets="@/styles/modern-ui.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kids.ui.MainDashboardController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="70.0" style="-fx-background-color: white; -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0; -fx-padding: 0 30 0 30;" BorderPane.alignment="CENTER">
            <Label style="-fx-font-weight: bold; -fx-font-size: 24px; -fx-text-fill: #10B981;" text="%main.title" />
            <Label style="-fx-font-size: 14px; -fx-text-fill: #64748B;" text="%main.subtitle" />

            <HBox alignment="CENTER_RIGHT" spacing="20.0" HBox.hgrow="ALWAYS">
                <Label fx:id="lblCurrentYear" style="-fx-background-color: #ECFDF5; -fx-background-radius: 20; -fx-padding: 6 18; -fx-text-fill: #059669; -fx-font-weight: bold; -fx-font-size: 13px;" text="%main.current.year" />
                <Button mnemonicParsing="false" onAction="#handleLogout" styleClass="btn-logout" text="%main.logout">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>
            </HBox>
        </HBox>
    </top>

    <left>
        <VBox prefHeight="580.0" prefWidth="169.0" spacing="6.0" style="-fx-background-color: #0F172A; -fx-padding: 25 15 25 15;" BorderPane.alignment="CENTER">
            <Button alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#showStudentsView" prefHeight="45.0" styleClass="sidebar-link" text="%menu.students">
                <cursor>
                    <Cursor fx:constant="HAND" />
                </cursor>
            </Button>

            <Button alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#showParentsView" prefHeight="45.0" styleClass="sidebar-link" text="%menu.parents">
                <cursor>
                    <Cursor fx:constant="HAND" />
                </cursor>
            </Button>

            <Button alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#showPaymentsView" prefHeight="45.0" styleClass="sidebar-link" text="%menu.payments">
                <cursor>
                    <Cursor fx:constant="HAND" />
                </cursor>
            </Button>

            <Button alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#showSessionsView" prefHeight="45.0" styleClass="sidebar-link" text="%menu.sessions">
                <cursor>
                    <Cursor fx:constant="HAND" />
                </cursor>
            </Button>

            <Button alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#showAttendanceView" prefHeight="45.0" styleClass="sidebar-link" text="%menu.attendance">
                <cursor>
                    <Cursor fx:constant="HAND" />
                </cursor>
            </Button>

            <Button alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#showTeachersView" prefHeight="45.0" styleClass="sidebar-link" text="%nav.employees">
                <cursor>
                    <Cursor fx:constant="HAND" />
                </cursor>
            </Button>

            <Button alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#showEmployeeView" prefHeight="45.0" styleClass="sidebar-link" text="%nav.admins">
                <cursor>
                    <Cursor fx:constant="HAND" />
                </cursor>
            </Button>


            <Button alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#showPayRollView" prefHeight="45.0" styleClass="sidebar-link" text="%nav.admins">
                <cursor>
                    <Cursor fx:constant="HAND" />
                </cursor>
            </Button>

            <VBox alignment="BOTTOM_CENTER" VBox.vgrow="ALWAYS">
                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#showSettingsView" prefHeight="45.0" styleClass="sidebar-link-settings" text="%menu.settings">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox fx:id="contentArea" alignment="CENTER" style="-fx-background-color: #F8FAFC; -fx-padding: 40;" BorderPane.alignment="CENTER">
            <VBox alignment="CENTER" spacing="12" style="-fx-background-color: white; -fx-padding: 45; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 12; -fx-max-width: 600;">
                <Label style="-fx-font-weight: bold; -fx-font-size: 26px; -fx-text-fill: #1E293B;" text="%welcome.title" />
                <Label style="-fx-font-size: 14px; -fx-text-fill: #64748B; -fx-text-alignment: center;" text="%welcome.subtitle" />
            </VBox>
        </VBox>
    </center>
</BorderPane>
