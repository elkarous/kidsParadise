<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<TabPane prefHeight="750.0" prefWidth="1100.0" tabClosingPolicy="UNAVAILABLE"
         style="-fx-background-color: #F8FAFC;"
         stylesheets="@/styles/modern-ui.css"
         xmlns="http://javafx.com/javafx/21"
         xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="com.kids.ui.StuffManagementController">
    <tabs>

        <Tab text="%nav.teachers">
            <content>
                <AnchorPane>
                    <children>
                        <VBox spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                            <padding>
                                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                            </padding>
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                    <children>
                                        <VBox HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label style="-fx-font-weight: bold; -fx-font-size: 24px; -fx-text-fill: #0F172A;" text="%nav.teachers" />
                                                <Label style="-fx-font-size: 13px; -fx-text-fill: #64748B;" text="إدارة بيانات المعلمين، العقود، والوظائف التربوية" />
                                            </children>
                                        </VBox>
                                        <Button mnemonicParsing="false" onAction="#handleAddNewTeacher" styleClass="btn-primary" text="➕ إضافة معلم جديد">
                                            <cursor><Cursor fx:constant="HAND" /></cursor>
                                        </Button>
                                    </children>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: white; -fx-padding: 12 20; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;">
                                    <children>
                                        <TextField fx:id="searchField" prefHeight="38.0" promptText="🔍 ابحث عن معلم بالاسم أو التخصص..." styleClass="modern-text-field" HBox.hgrow="ALWAYS" />
                                        <ComboBox fx:id="comboTeacherSalaryType" prefHeight="38.0" prefWidth="180.0" promptText="طريقة الاحتساب" styleClass="modern-combo-box" />
                                    </children>
                                </HBox>

                                <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-padding: 15;" VBox.vgrow="ALWAYS">
                                    <children>
                                        <TableView fx:id="teacherTable" styleClass="modern-table" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="colTeacherAction" maxWidth="100.0" minWidth="90.0" prefWidth="95.0" resizable="false" sortable="false" text="إجراءات" />
                                                <TableColumn fx:id="colName" prefWidth="250.0" text="%teacher.name" />
                                                <TableColumn fx:id="colSpecialty" prefWidth="200.0" text="%teacher.specialty" />
                                                <TableColumn fx:id="colSalaryType" prefWidth="200.0" text="%teacher.salary.type" />
                                                <TableColumn fx:id="colStatus" prefWidth="130.0" style="-fx-alignment: CENTER;" text="%teacher.status" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </AnchorPane>
            </content>
        </Tab>

        <Tab text="%nav.employees">
            <content>
                <AnchorPane>
                    <children>
                        <VBox spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                            <padding>
                                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                            </padding>
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                    <children>
                                        <VBox HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label style="-fx-font-weight: bold; -fx-font-size: 24px; -fx-text-fill: #0F172A;" text="%nav.employees" />
                                                <Label style="-fx-font-size: 13px; -fx-text-fill: #64748B;" text="إدارة بيانات الطاقم الإداري، الخدمات، والعمال" />
                                            </children>
                                        </VBox>
                                        <Button mnemonicParsing="false" onAction="#handleAddNewEmployee" styleClass="btn-primary" text="💼 إضافة موظف جديد">
                                            <cursor><Cursor fx:constant="HAND" /></cursor>
                                        </Button>
                                    </children>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: white; -fx-padding: 12 20; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;">
                                    <children>
                                        <TextField fx:id="searchEmployeeField" prefHeight="38.0" promptText="🔍 ابحث عن موظف بالاسم أو الدور الوظيفي..." styleClass="modern-text-field" HBox.hgrow="ALWAYS" />
                                        <ComboBox fx:id="comboEmployeeSalaryType" prefHeight="38.0" prefWidth="180.0" promptText="طريقة الاحتساب" styleClass="modern-combo-box" />
                                    </children>
                                </HBox>

                                <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-padding: 15;" VBox.vgrow="ALWAYS">
                                    <children>
                                        <TableView fx:id="employeeTable" styleClass="modern-table" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="colEmployeeAction" maxWidth="100.0" minWidth="90.0" prefWidth="95.0" resizable="false" sortable="false" text="إجراءات" />
                                                <TableColumn fx:id="colEmployeeName" prefWidth="250.0" text="%teacher.name" />
                                                <TableColumn fx:id="colEmployeeRole" prefWidth="200.0" text="%teacher.specialty" />
                                                <TableColumn fx:id="colEmployeeSalaryType" prefWidth="200.0" text="%teacher.salary.type" />
                                                <TableColumn fx:id="colEmployeeStatus" prefWidth="130.0" style="-fx-alignment: CENTER;" text="%teacher.status" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </AnchorPane>
            </content>
        </Tab>

    </tabs>
</TabPane>