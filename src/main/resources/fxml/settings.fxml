<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<VBox spacing="20.0" style="-fx-padding: 30; -fx-background-color: #F8FAFC;"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.kids.ui.SettingsController" stylesheets="@/styles/modern-ui.css">

    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label text="⚙️" style="-fx-font-size: 24px;"/>
        <VBox HBox.hgrow="ALWAYS">
            <Label text="%settings.title" style="-fx-font-weight: bold; -fx-font-size: 22px; -fx-text-fill: #0F172A;"/>
            <Label text="%settings.subtitle" style="-fx-font-size: 13px; -fx-text-fill: #64748B;"/>
        </VBox>
        <HBox alignment="CENTER" spacing="8" style="-fx-background-color: white; -fx-padding: 6 12; -fx-background-radius: 6; -fx-border-color: #E2E8F0; -fx-border-radius: 6;">
            <Label text="🌐" style="-fx-font-size: 14px;"/>
            <ComboBox fx:id="comboLanguage" onAction="#handleLanguageChange" style="-fx-background-color: transparent; -fx-cursor: hand;">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="العربية" />
                        <String fx:value="English" />
                    </FXCollections>
                </items>
            </ComboBox>
        </HBox>
    </HBox>

    <TabPane fx:id="settingsTabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" styleClass="modern-tab-pane">

        <Tab text="%tab.general">
            <VBox spacing="20.0" style="-fx-padding: 25; -fx-background-color: white;">
                <VBox styleClass="settings-card" spacing="15">
                    <Label text="%card.general.title" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #1E293B;"/>
                    <GridPane hgap="20.0" vgap="15.0">
                        <columnConstraints>
                            <ColumnConstraints prefWidth="120.0" />
                            <ColumnConstraints hgrow="ALWAYS" />
                        </columnConstraints>

                        <Label text="%label.kg.name" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <TextField fx:id="txtKindergartenName" styleClass="modern-text-field" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                        <Label text="%label.kg.phone" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <TextField fx:id="txtKindergartenPhone" styleClass="modern-text-field" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                        <Label text="%label.kg.address" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <TextField fx:id="txtKindergartenAddress" styleClass="modern-text-field" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    </GridPane>
                </VBox>

                <HBox alignment="TOP_LEFT">
                    <Button text="%btn.save.general" onAction="#handleSaveGeneralSettings" styleClass="btn-success"/>
                </HBox>
            </VBox>
        </Tab>

        <Tab text="%tab.years">
            <VBox spacing="20.0" style="-fx-padding: 25; -fx-background-color: white;">

                <VBox styleClass="settings-card" spacing="12">
                    <Label text="%card.years.title" style="-fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #1E293B;"/>
                    <Label text="%card.years.subtitle" style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>
                    <HBox spacing="12.0" alignment="CENTER_LEFT">
                        <TextField fx:id="txtYearName" promptText="%prompt.year.format" prefWidth="220.0" styleClass="modern-text-field"/>
                        <Button text="%btn.create.year" onAction="#handleCreateYear" styleClass="btn-primary"/>
                    </HBox>
                </VBox>

                <VBox VBox.vgrow="ALWAYS" spacing="10">
                    <Label text="%table.title" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #334155;"/>
                    <TableView fx:id="yearTable" VBox.vgrow="ALWAYS" styleClass="modern-table">
                        <columns>
                            <TableColumn fx:id="colId" prefWidth="80.0" text="%col.id"/>
                            <TableColumn fx:id="colYearName" prefWidth="300.0" text="%col.year"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </VBox>
        </Tab>
    </TabPane>
</VBox>