<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.kindererp.controller.StudentListController" styleClass="page">

    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox HBox.hgrow="ALWAYS">
            <Label text="%students.title" styleClass="page-title"/>
            <Label text="%students.subtitle" styleClass="page-subtitle"/>
        </VBox>
        <Button text="%students.add" onAction="#handleAdd" styleClass="btn-primary"/>
    </HBox>

    <HBox styleClass="toolbar">
        <TextField fx:id="searchField" promptText="%students.search" HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="levelFilter" prefWidth="180" promptText="%class.level"/>
        <ComboBox fx:id="classFilter" prefWidth="180" promptText="%class.name"/>
        <Label fx:id="countLabel" styleClass="hint"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="lastNameColumn" text="%student.lastName" prefWidth="160"/>
            <TableColumn fx:id="firstNameColumn" text="%student.firstName" prefWidth="160"/>
            <TableColumn fx:id="birthDateColumn" text="%student.birthDate" prefWidth="130"/>
            <TableColumn fx:id="levelColumn" text="%class.level" prefWidth="140"/>
            <TableColumn fx:id="classColumn" text="%class.name" prefWidth="140"/>
            <TableColumn fx:id="parentColumn" text="%student.parent" prefWidth="180"/>
            <TableColumn fx:id="deleteColumn" prefWidth="60" minWidth="60" maxWidth="60"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
    </TableView>
</VBox>
