<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.kindererp.controller.StaffFormController" styleClass="dialog-content" prefWidth="560">

    <GridPane styleClass="form">
        <columnConstraints>
            <ColumnConstraints minWidth="170"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        <Label text="%staff.name" styleClass="field-label" GridPane.rowIndex="0"/>
        <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label fx:id="positionLabel" styleClass="field-label" GridPane.rowIndex="1"/>
        <TextField fx:id="positionField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="%staff.phone" styleClass="field-label" GridPane.rowIndex="2"/>
        <TextField fx:id="phoneField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="%staff.email" styleClass="field-label" GridPane.rowIndex="3"/>
        <TextField fx:id="emailField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        <Label text="%staff.hiringDate" styleClass="field-label" GridPane.rowIndex="4"/>
        <DatePicker fx:id="hiringDatePicker" maxWidth="Infinity" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
        <Label text="%staff.status" styleClass="field-label" GridPane.rowIndex="5"/>
        <ComboBox fx:id="statusCombo" maxWidth="Infinity" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
        <Label text="%staff.salaryType" styleClass="field-label" GridPane.rowIndex="6"/>
        <ComboBox fx:id="salaryTypeCombo" maxWidth="Infinity" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
        <Label fx:id="baseSalaryLabel" styleClass="field-label" GridPane.rowIndex="7"/>
        <TextField fx:id="baseSalaryField" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
        <Label fx:id="penaltyLabel" text="%staff.absencePenalty" styleClass="field-label" GridPane.rowIndex="8"/>
        <TextField fx:id="penaltyField" GridPane.rowIndex="8" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox styleClass="button-bar">
        <Button text="%btn.cancel" onAction="#handleCancel" cancelButton="true"/>
        <Button fx:id="saveButton" text="%btn.save" onAction="#handleSave" defaultButton="true" styleClass="btn-primary"/>
    </HBox>
</VBox>
