<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.kids.ui.AttendanceController" style="-fx-background-color: #f8f9fa;"
      AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <HBox spacing="15.0" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 12; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 1);">

        <Label text="%attendance.level" style="-fx-font-weight: bold;"/>
        <ComboBox fx:id="comboLevel" prefWidth="150.0" promptText="%attendance.chooseLevel"/>

        <Label text="%attendance.class" style="-fx-font-weight: bold;"/>
        <ComboBox fx:id="comboClass" prefWidth="180.0" promptText="%attendance.chooseClass"/>

        <Label text="%attendance.date" style="-fx-font-weight: bold;"/>
        <DatePicker fx:id="datePicker" prefWidth="150.0"/>

        <Region HBox.hgrow="ALWAYS" />

        <Button fx:id="btnSaveAttendance" text="%btn.saveAttendance" onAction="#handleSaveAttendance"
                style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;"/>
    </HBox>

    <TableView fx:id="attendanceTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 8;">
        <columns>
            <TableColumn fx:id="colStudentName" prefWidth="200.0" text="%student.name"/>
            <TableColumn fx:id="colTeacherName" prefWidth="150.0" text="%class.teacher" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colStatusAction" prefWidth="150.0" text="%attendance.status" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colNotes" prefWidth="200.0" text="%payment.notes"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
</VBox>