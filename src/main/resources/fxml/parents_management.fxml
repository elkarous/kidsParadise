<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" style="-fx-background-color: #F8FAFC;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.kids.ui.ParentController"
      stylesheets="@/styles/modern-ui.css">

    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/>
    </padding>

    <children>
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <VBox HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="👨‍👩‍👦 إدارة أولياء الأمور" style="-fx-font-weight: bold; -fx-font-size: 24px; -fx-text-fill: #0F172A;"/>
                        <Label text="إدارة بيانات الاتصال بالأولياء ومتابعة المستحقات المالية الإجمالية" style="-fx-font-size: 13px; -fx-text-fill: #64748B;"/>
                    </children>
                </VBox>
                <Button mnemonicParsing="false" onAction="#openParentPopup" styleClass="btn-primary" text="➕ إضافة ولي أمر">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: white; -fx-padding: 12 20; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;">
            <children>
                <Label text="🔍" style="-fx-font-size: 16px;"/>
                <TextField fx:id="txtSearch" promptText="%search.placeholder" styleClass="modern-text-field" HBox.hgrow="ALWAYS" prefHeight="38.0"/>
            </children>
        </HBox>

        <AnchorPane style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-padding: 10;" VBox.vgrow="ALWAYS">
            <children>
                <TableView fx:id="parentTable" styleClass="modern-table" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <columns>
                        <TableColumn fx:id="colAction" maxWidth="90.0" minWidth="90.0" prefWidth="90.0" resizable="false" sortable="false" text="إجراءات" style="-fx-alignment: CENTER;" />
                        <TableColumn fx:id="colFatherName" prefWidth="180.0" text="%parent.fatherName"/>
                        <TableColumn fx:id="colMotherName" prefWidth="180.0" text="%parent.motherName"/>
                        <TableColumn fx:id="colPhone" prefWidth="140.0" text="%parent.phone"/>
                        <TableColumn fx:id="colStudentCount" prefWidth="120.0" text="%parent.student.count" style="-fx-alignment: CENTER;" />
                        <TableColumn fx:id="colTotalFees" prefWidth="140.0" text="%parent.total.fee" style="-fx-alignment: CENTER-RIGHT; -fx-padding: 0 15 0 0;" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </children>
        </AnchorPane>
    </children>
</VBox>