<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.kids.ui.PaymentController" style="-fx-background-color: #f8f9fa;"
      AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <HBox spacing="15.0" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 12; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 1);">
        <Label text="%search.parent" style="-fx-font-weight: bold;"/>
        <TextField fx:id="txtSearch" promptText="%search.placeholder" prefWidth="250.0" style="-fx-background-radius: 5;"/>

        <Separator orientation="VERTICAL" prefHeight="20.0" />

        <Label text="%payment.targetMonth" style="-fx-font-weight: bold;"/>
        <ComboBox fx:id="comboMonth" prefWidth="150.0" style="-fx-background-radius: 5;"/>
    </HBox>

    <TableView fx:id="paymentTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 8;">
        <columns>
            <TableColumn fx:id="colAction" prefWidth="120.0" text="%table.action" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colParentName" prefWidth="150.0" text="%parent.fatherName"/>
            <TableColumn fx:id="colChildrenCount" prefWidth="100.0" text="%parent.childrenCount" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colRequiredAmount" prefWidth="130.0" text="%payment.requiredAmount" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colStatus" prefWidth="120.0" text="%payment.status" style="-fx-alignment: CENTER;"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <HBox spacing="30.0" alignment="CENTER_RIGHT" style="-fx-background-color: #e9ecef; -fx-padding: 15; -fx-background-radius: 8;">

        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <Label text="%payment.totalExpected" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
            <Label fx:id="lblTotalExpected" text="0.000" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #495057;"/>
        </HBox>

        <Separator orientation="VERTICAL" prefHeight="20.0" />

        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <Label text="%payment.totalCollected" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
            <Label fx:id="lblTotalCollected" text="0.000" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #28a745;"/>
        </HBox>

        <Separator orientation="VERTICAL" prefHeight="20.0" />

        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <Label text="%payment.totalPending" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
            <Label fx:id="lblTotalPending" text="0.000" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #dc3545;"/>
        </HBox>
    </HBox>
</VBox>