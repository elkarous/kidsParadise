<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kids.ui.StudentFormController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <!-- عنوان النموذج المترجم -->
        <Label fx:id="lblFormTitle" textFill="#2c3e50">
            <font><Font name="System Bold" size="18.0" /></font>
        </Label>

        <!-- حقل الاسم الأول -->
        <VBox spacing="5.0">
            <children>
                <Label text="%firstName" />
                <TextField fx:id="txtFirstName" />
            </children>
        </VBox>

        <!-- حقل اللقب -->
        <VBox spacing="5.0">
            <children>
                <Label text="%lastName" />
                <TextField fx:id="txtLastName" />
            </children>
        </VBox>

        <!-- حقل تاريخ الميلاد الجديد -->
        <VBox spacing="5.0">
            <children>
                <Label text="%birthDate" />
                <DatePicker fx:id="dateBirthDate" maxWidth="1.7976931348623157E308" />
            </children>
        </VBox>

        <!-- حقل المستوى التعليمي -->
        <VBox spacing="5.0">
            <children>
                <Label text="%level" /> <!-- أو أي مفتاح تريد تخصيصه للمستوى -->
                <ComboBox fx:id="comboLevel" maxWidth="1.7976931348623157E308" />
            </children>
        </VBox>

        <!-- حقل القسم الدراسي -->
        <VBox spacing="5.0">
            <children>
                <Label text="%class" /> <!-- تأكد من تعديل المفتاح المناسب للقسم إذا وجد -->
                <ComboBox fx:id="comboClass" maxWidth="1.7976931348623157E308" />
            </children>
        </VBox>

        <!-- حقل ولي الأمر -->
        <VBox spacing="5.0">
            <children>
                <Label text="%parent" /> <!-- غير المفتاح إلى مفتاح الولي في الـ properties لاحقاً إن أردت -->
                <ComboBox fx:id="comboParent" maxWidth="1.7976931348623157E308" />
            </children>
        </VBox>

        <!-- زر الحفظ المترجم -->
        <Button fx:id="btnSave" maxWidth="1.7976931348623157E308" onAction="#onSave" prefHeight="35.0" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold;" text="%btn.save" />
    </children>
</VBox>