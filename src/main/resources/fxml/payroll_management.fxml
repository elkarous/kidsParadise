<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<TabPane prefHeight="750.0" prefWidth="1150.0" style="-fx-background-color: #F8FAFC;" stylesheets="@/styles/modern-ui.css" tabClosingPolicy="UNAVAILABLE" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kids.ui.PayrollManagementController">
    <tabs>
        <Tab text="مسير رواتب المعلمين / Teachers Payroll">
            <content>
                <AnchorPane>
                    <children>
                        <HBox spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                            </padding>
                            <children>
                                <TableView fx:id="teacherPayrollTable" styleClass="modern-table" HBox.hgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colTeacherPayrollName" prefWidth="200.0" text="%teacher.name" />
                                        <TableColumn fx:id="colTeacherSalaryType" prefWidth="130.0" text="طبيعة الأجر" />
                                        <TableColumn fx:id="colTeacherPending" prefWidth="150.0" style="-fx-alignment: CENTER; -fx-text-fill: #DC2626;" text="%salary.pending" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>

                                <VBox prefWidth="400.0" spacing="15.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #DEF7EC; -fx-border-radius: 12;">
                                    <children>
                                        <Label style="-fx-font-weight: 800; -fx-font-size: 16px; -fx-text-fill: #0F172A;" text="صرف مستحقات المعلم المحدد" />
                                        <Separator />
                                        <VBox spacing="10.0" style="-fx-background-color: #F8FAFC; -fx-padding: 15; -fx-background-radius: 10;">
                                            <children>
                                                <HBox alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label style="-fx-text-fill: #64748B; -fx-font-size: 13px;" text="المستحق الإجمالي:" />
                                                        <Region HBox.hgrow="ALWAYS" />
                                                        <Label fx:id="lblTeacherGross" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #0F172A;" text="0.000 DT" />
                                                    </children>
                                                </HBox>
                                                <Separator />
                                                <HBox alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #DC2626;" text="صافي الصرف المتبقي:" />
                                                        <Region HBox.hgrow="ALWAYS" />
                                                        <Label fx:id="lblTeacherPending" style="-fx-font-weight: 900; -fx-font-size: 16px; -fx-text-fill: #DC2626;" text="0.000 DT" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                        <VBox spacing="12.0">
                                            <children>
                                                <VBox spacing="5.0">
                                                    <children>
                                                        <Label styleClass="field-label" text="المبلغ المراد صرفه الآن:" />
                                                        <TextField fx:id="txtTeacherPayAmount" prefHeight="40.0" promptText="0.000" styleClass="modern-text-field" />
                                                    </children>
                                                </VBox>
                                                <VBox spacing="5.0">
                                                    <children>
                                                        <Label styleClass="field-label" text="%payroll.payment.method" />
                                                        <ComboBox fx:id="cbTeacherPaymentMethod" maxWidth="1.7976931348623157E308" prefHeight="40.0" styleClass="modern-combo-box" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </VBox>
                                        <Button fx:id="btnPayTeacher" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handlePayTeacher" prefHeight="45.0" styleClass="btn-success" text="تأكيد صرف راتب الأستاذ">
                                            <cursor><Cursor fx:constant="HAND" /></cursor>
                                        </Button>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </AnchorPane>
            </content>
        </Tab>

        <Tab text="مسير رواتب الإداريين / Staff Payroll">
            <content>
                <AnchorPane>
                    <children>
                        <HBox spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                            </padding>
                            <children>
                                <TableView fx:id="employeePayrollTable" styleClass="modern-table" HBox.hgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colEmployeePayrollName" prefWidth="200.0" text="%admin.name" />
                                        <TableColumn fx:id="colEmployeeRole" prefWidth="130.0" text="الدور الوظيفي" />
                                        <TableColumn fx:id="colEmployeePending" prefWidth="150.0" style="-fx-alignment: CENTER; -fx-text-fill: #DC2626;" text="%salary.pending" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>

                                <VBox prefWidth="400.0" spacing="15.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #DEF7EC; -fx-border-radius: 12;">
                                    <children>
                                        <Label style="-fx-font-weight: 800; -fx-font-size: 16px; -fx-text-fill: #0F172A;" text="صرف مستحقات الموظف المحدد" />
                                        <Separator />
                                        <VBox spacing="10.0" style="-fx-background-color: #F8FAFC; -fx-padding: 15; -fx-background-radius: 10;">
                                            <children>
                                                <HBox alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label style="-fx-text-fill: #64748B; -fx-font-size: 13px;" text="الأجر الشهري الثابت:" />
                                                        <Region HBox.hgrow="ALWAYS" />
                                                        <Label fx:id="lblEmployeeGross" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #0F172A;" text="0.000 DT" />
                                                    </children>
                                                </HBox>
                                                <Separator />
                                                <HBox alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #DC2626;" text="صافي المتبقي للصرف:" />
                                                        <Region HBox.hgrow="ALWAYS" />
                                                        <Label fx:id="lblEmployeePending" style="-fx-font-weight: 900; -fx-font-size: 16px; -fx-text-fill: #DC2626;" text="0.000 DT" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                        <VBox spacing="12.0">
                                            <children>
                                                <VBox spacing="5.0">
                                                    <children>
                                                        <Label styleClass="field-label" text="المبلغ المراد صرفه الآن:" />
                                                        <TextField fx:id="txtEmployeePayAmount" prefHeight="40.0" promptText="0.000" styleClass="modern-text-field" />
                                                    </children>
                                                </VBox>
                                                <VBox spacing="5.0">
                                                    <children>
                                                        <Label styleClass="field-label" text="%payroll.payment.method" />
                                                        <ComboBox fx:id="cbEmployeePaymentMethod" maxWidth="1.7976931348623157E308" prefHeight="40.0" styleClass="modern-combo-box" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </VBox>
                                        <Button fx:id="btnPayEmployee" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handlePayEmployee" prefHeight="45.0" styleClass="btn-success" text="تأكيد صرف راتب الموظف">
                                            <cursor><Cursor fx:constant="HAND" /></cursor>
                                        </Button>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </AnchorPane>
            </content>
        </Tab>
    </tabs>
</TabPane>