<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="750.0" prefWidth="1200.0" spacing="15.0" style="-fx-background-color: #F8FAFC;" stylesheets="@/styles/modern-ui.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kids.ui.PayrollManagementController">
    <children>

        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-padding: 12 20; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10;">
            <VBox.margin>
                <Insets left="20.0" right="20.0" top="20.0" />
            </VBox.margin>
            <children>
                <Label style="-fx-font-weight: bold; -fx-text-fill: #1E293B; -fx-font-size: 14px;" text="📅 الشهر الدراسي النشط:" />
                <ComboBox fx:id="cbPayrollMonth" prefHeight="38.0" prefWidth="280.0" styleClass="modern-combo-box" />
                <Label style="-fx-text-fill: #64748B; -fx-font-size: 13px;" text="(تغيير الشهر يعرض فوراً المسيرات المأخوذة والمدفوعات والمبالغ المتبقية له تلقائياً)" />
                <Region HBox.hgrow="ALWAYS" />
            </children>
        </HBox>

        <TabPane style="-fx-background-color: transparent;" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
            <tabs>
                <Tab text="مسير رواتب الأساتذة">
                    <content>
                        <HBox spacing="20.0">
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
                            </padding>
                            <children>
                                <TableView fx:id="teacherPayrollTable" styleClass="modern-table" HBox.hgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colTeacherPayrollName" prefWidth="180.0" text="اسم الأستاذ" />
                                        <TableColumn fx:id="colTeacherGross" prefWidth="110.0" style="-fx-alignment: CENTER;" text="المستحق الكلي" />
                                        <TableColumn fx:id="colTeacherPaid" prefWidth="110.0" style="-fx-alignment: CENTER; -fx-text-fill: #16A34A;" text="المدفوع سابقاً" />
                                        <TableColumn fx:id="colTeacherPending" prefWidth="110.0" style="-fx-alignment: CENTER; -fx-text-fill: #DC2626;" text="الصافي المتبقي" />
                                        <TableColumn fx:id="colTeacherStatus" prefWidth="120.0" style="-fx-alignment: CENTER;" text="حالة الدفع" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>

                                <ScrollPane hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0; -fx-border-width: 0;" maxWidth="380.0" minWidth="360.0" HBox.hgrow="NEVER">
                                    <content>
                                        <VBox spacing="15.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 12;">
                                            <children>
                                                <Label style="-fx-font-weight: 800; -fx-font-size: 16px; -fx-text-fill: #0F172A;" text="صرف مستحقات المعلم" />
                                                <Separator />
                                                <VBox spacing="10.0" style="-fx-background-color: #F8FAFC; -fx-padding: 15; -fx-background-radius: 10;">
                                                    <children>
                                                        <HBox alignment="CENTER_LEFT"><children><Label style="-fx-text-fill: #64748B;" text="المستحق الإجمالي:" /><Region HBox.hgrow="ALWAYS" /><Label fx:id="lblTeacherGross" style="-fx-font-weight: bold;" text="0.000 DT" /></children></HBox>
                                                        <HBox alignment="CENTER_LEFT"><children><Label style="-fx-text-fill: #16A34A;" text="المدفوع بالفعل:" /><Region HBox.hgrow="ALWAYS" /><Label fx:id="lblTeacherPaid" style="-fx-font-weight: bold; -fx-text-fill: #16A34A;" text="0.000 DT" /></children></HBox>
                                                        <Separator />
                                                        <HBox alignment="CENTER_LEFT"><children><Label style="-fx-font-weight: bold; -fx-text-fill: #DC2626;" text="المتبقي للصرف:" /><Region HBox.hgrow="ALWAYS" /><Label fx:id="lblTeacherPending" style="-fx-font-weight: 900; -fx-font-size: 16px; -fx-text-fill: #DC2626;" text="0.000 DT" /></children></HBox>
                                                    </children>
                                                </VBox>
                                                <VBox spacing="12.0">
                                                    <children>
                                                        <VBox spacing="5.0"><children><Label styleClass="field-label" text="المبلغ المراد صرفه الآن:" /><TextField fx:id="txtTeacherPayAmount" prefHeight="40.0" styleClass="modern-text-field" /></children></VBox>
                                                        <VBox spacing="5.0"><children><Label styleClass="field-label" text="طريقة الدفع:" /><ComboBox fx:id="cbTeacherPaymentMethod" maxWidth="1.7976931348623157E308" prefHeight="40.0" styleClass="modern-combo-box" /></children></VBox>
                                                    </children>
                                                </VBox>
                                                <Button fx:id="btnPayTeacher" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handlePayTeacher" prefHeight="45.0" styleClass="btn-success" text="تأكيد عملية الصرف"><cursor><Cursor fx:constant="HAND" /></cursor></Button>
                                            </children>
                                        </VBox>
                                    </content>
                                </ScrollPane>
                            </children>
                        </HBox>
                    </content>
                </Tab>

                <Tab text="مسير رواتب الموظفين والإداريين">
                    <content>
                        <HBox spacing="20.0">
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
                            </padding>
                            <children>
                                <TableView fx:id="employeePayrollTable" styleClass="modern-table" HBox.hgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colEmployeePayrollName" prefWidth="180.0" text="اسم الموظف" />
                                        <TableColumn fx:id="colEmployeeGross" prefWidth="110.0" style="-fx-alignment: CENTER;" text="الراتب الشهري" />
                                        <TableColumn fx:id="colEmployeePaid" prefWidth="110.0" style="-fx-alignment: CENTER; -fx-text-fill: #16A34A;" text="المدفوع سابقاً" />
                                        <TableColumn fx:id="colEmployeePending" prefWidth="110.0" style="-fx-alignment: CENTER; -fx-text-fill: #DC2626;" text="الصافي المتبقي" />
                                        <TableColumn fx:id="colEmployeeStatus" prefWidth="120.0" style="-fx-alignment: CENTER;" text="حالة الدفع" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>

                                <ScrollPane hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0; -fx-border-width: 0;" maxWidth="380.0" minWidth="360.0" HBox.hgrow="NEVER">
                                    <content>
                                        <VBox spacing="15.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 12;">
                                            <children>
                                                <Label style="-fx-font-weight: 800; -fx-font-size: 16px; -fx-text-fill: #0F172A;" text="صرف مستحقات الموظف" />
                                                <Separator />
                                                <VBox spacing="10.0" style="-fx-background-color: #F8FAFC; -fx-padding: 15; -fx-background-radius: 10;">
                                                    <children>
                                                        <HBox alignment="CENTER_LEFT"><children><Label style="-fx-text-fill: #64748B;" text="الأجر الثابت المعين:" /><Region HBox.hgrow="ALWAYS" /><Label fx:id="lblEmployeeGross" style="-fx-font-weight: bold;" text="0.000 DT" /></children></HBox>
                                                        <HBox alignment="CENTER_LEFT"><children><Label style="-fx-text-fill: #16A34A;" text="المبلغ المدفوع:" /><Region HBox.hgrow="ALWAYS" /><Label fx:id="lblEmployeePaid" style="-fx-font-weight: bold; -fx-text-fill: #16A34A;" text="0.000 DT" /></children></HBox>
                                                        <Separator />
                                                        <HBox alignment="CENTER_LEFT"><children><Label style="-fx-font-weight: bold; -fx-text-fill: #DC2626;" text="صافي المتبقي:" /><Region HBox.hgrow="ALWAYS" /><Label fx:id="lblEmployeePending" style="-fx-font-weight: 900; -fx-font-size: 16px; -fx-text-fill: #DC2626;" text="0.000 DT" /></children></HBox>
                                                    </children>
                                                </VBox>
                                                <VBox spacing="12.0">
                                                    <children>
                                                        <VBox spacing="5.0"><children><Label styleClass="field-label" text="المبلغ المراد صرفه الآن:" /><TextField fx:id="txtEmployeePayAmount" prefHeight="40.0" styleClass="modern-text-field" /></children></VBox>
                                                        <VBox spacing="5.0"><children><Label styleClass="field-label" text="طريقة الدفع:" /><ComboBox fx:id="cbEmployeePaymentMethod" maxWidth="1.7976931348623157E308" prefHeight="40.0" styleClass="modern-combo-box" /></children></VBox>
                                                    </children>
                                                </VBox>
                                                <Button fx:id="btnPayEmployee" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handlePayEmployee" prefHeight="45.0" styleClass="btn-success" text="تأكيد عملية الصرف"><cursor><Cursor fx:constant="HAND" /></cursor></Button>
                                            </children>
                                        </VBox>
                                    </content>
                                </ScrollPane>
                            </children>
                        </HBox>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </children>
</VBox>