<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<TabPane prefHeight="700.0" prefWidth="950.0" tabClosingPolicy="UNAVAILABLE"
         style="-fx-background-color: #F8FAFC;"
         stylesheets="@/styles/modern-ui.css"
         xmlns="http://javafx.com/javafx/21"
         xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="com.kids.ui.SpacesManagementController">
    <tabs>

        <Tab text="%space.levelsManagement">
            <content>
                <AnchorPane minHeight="0.0" minWidth="0.0">
                    <children>
                        <VBox spacing="18.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                            <padding>
                                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                            </padding>
                            <children>
                                <VBox spacing="4.0">
                                    <children>
                                        <Label style="-fx-font-weight: 800; -fx-font-size: 20px; -fx-text-fill: #0F172A;" text="%space.levelsManagement" />
                                        <Label style="-fx-font-size: 13px; -fx-text-fill: #64748B;" text="إضافة، تحديث، أو حذف المراحل والمستويات التعليمية الخاصة بالمؤسسة" />
                                    </children>
                                </VBox>

                                <TableView fx:id="levelTable" styleClass="modern-table" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colLevelId" maxWidth="100.0" minWidth="70.0" prefWidth="80.0" resizable="false" style="-fx-alignment: CENTER;" text="ID" />
                                        <TableColumn fx:id="colLevelName" prefWidth="750.0" text="%space.levelName" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>

                                <VBox spacing="12.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 12;">
                                    <children>
                                        <Label styleClass="field-label" text="%space.levelName" />
                                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                                            <children>
                                                <TextField fx:id="txtLevelName" prefHeight="40.0" promptText="%space.levelNamePrompt" styleClass="modern-text-field" HBox.hgrow="ALWAYS" />
                                                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                                    <children>
                                                        <Button mnemonicParsing="false" onAction="#handleDeleteLevel" prefHeight="40.0" prefWidth="90.0" styleClass="btn-danger" text="%btn.delete">
                                                            <cursor><Cursor fx:constant="HAND" /></cursor>
                                                        </Button>
                                                        <Button mnemonicParsing="false" onAction="#handleUpdateLevel" prefHeight="40.0" prefWidth="95.0" styleClass="btn-secondary" text="%btn.update">
                                                            <cursor><Cursor fx:constant="HAND" /></cursor>
                                                        </Button>
                                                        <Button mnemonicParsing="false" onAction="#handleAddLevel" prefHeight="40.0" prefWidth="100.0" styleClass="btn-primary" text="%btn.add">
                                                            <cursor><Cursor fx:constant="HAND" /></cursor>
                                                        </Button>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </AnchorPane>
            </content>
        </Tab>

        <Tab text="%space.classesManagement">
            <content>
                <AnchorPane minHeight="0.0" minWidth="0.0">
                    <children>
                        <VBox spacing="18.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                            <padding>
                                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                            </padding>
                            <children>
                                <VBox spacing="4.0">
                                    <children>
                                        <Label style="-fx-font-weight: 800; -fx-font-size: 20px; -fx-text-fill: #0F172A;" text="%space.classesManagement" />
                                        <Label style="-fx-font-size: 13px; -fx-text-fill: #64748B;" text="توزيع الفصول الدراسية، ربطها بالمستويات وتعيين المربين والمدرسين" />
                                    </children>
                                </VBox>

                                <TableView fx:id="classTable" styleClass="modern-table" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colClassId" maxWidth="80.0" minWidth="60.0" prefWidth="70.0" resizable="false" style="-fx-alignment: CENTER;" text="ID" />
                                        <TableColumn fx:id="colClassName" prefWidth="250.0" text="%space.className" />
                                        <TableColumn fx:id="colClassLevel" prefWidth="250.0" text="%attendance.level" />
                                        <TableColumn fx:id="colClassTeacher" prefWidth="250.0" text="%class.teacher" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>

                                <VBox spacing="15.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 12;">
                                    <children>

                                        <HBox spacing="15.0" alignment="BOTTOM_LEFT">
                                            <children>

                                                <VBox spacing="6.0" HBox.hgrow="ALWAYS" minWidth="200.0">
                                                    <children>
                                                        <Label styleClass="field-label" text="%space.className" />
                                                        <TextField fx:id="txtClassName" prefHeight="40.0" promptText="%space.classNamePrompt" styleClass="modern-text-field" maxWidth="1.7976931348623157E308" />
                                                    </children>
                                                </VBox>

                                                <VBox spacing="6.0" HBox.hgrow="ALWAYS" minWidth="200.0">
                                                    <children>
                                                        <Label styleClass="field-label" text="%attendance.level" />
                                                        <ComboBox fx:id="comboLevelFilter" maxWidth="1.7976931348623157E308" prefHeight="40.0" promptText="%attendance.chooseLevel" styleClass="modern-combo-box" />
                                                    </children>
                                                </VBox>

                                                <VBox spacing="6.0" HBox.hgrow="ALWAYS" minWidth="200.0">
                                                    <children>
                                                        <Label styleClass="field-label" text="%class.teacher" />
                                                        <ComboBox fx:id="comboTeacherFilter" maxWidth="1.7976931348623157E308" prefHeight="40.0" promptText="%space.chooseTeacher" styleClass="modern-combo-box" />
                                                    </children>
                                                </VBox>

                                            </children>
                                        </HBox>

                                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                            <VBox.margin>
                                                <Insets top="10.0" />
                                            </VBox.margin>
                                            <children>
                                                <Button mnemonicParsing="false" onAction="#handleDeleteClass" prefHeight="40.0" prefWidth="90.0" styleClass="btn-danger" text="%btn.delete">
                                                    <cursor><Cursor fx:constant="HAND" /></cursor>
                                                </Button>
                                                <Button mnemonicParsing="false" onAction="#handleUpdateClass" prefHeight="40.0" prefWidth="95.0" styleClass="btn-secondary" text="%btn.update">
                                                    <cursor><Cursor fx:constant="HAND" /></cursor>
                                                </Button>
                                                <Button mnemonicParsing="false" onAction="#handleAddClass" prefHeight="40.0" prefWidth="100.0" styleClass="btn-primary" text="%btn.add">
                                                    <cursor><Cursor fx:constant="HAND" /></cursor>
                                                </Button>
                                            </children>
                                        </HBox>

                                    </children>
                                </VBox>                            </children>
                        </VBox>
                    </children>
                </AnchorPane>
            </content>
        </Tab>
    </tabs>
</TabPane>