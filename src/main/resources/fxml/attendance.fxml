<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.kindererp.controller.AttendanceController" styleClass="page">

    <VBox>
        <Label text="%attendance.title" styleClass="page-title"/>
        <Label text="%attendance.subtitle" styleClass="page-subtitle"/>
    </VBox>

    <HBox styleClass="toolbar">
        <Label text="%class.name" styleClass="field-label"/>
        <ComboBox fx:id="classCombo" prefWidth="240"/>
        <Label text="%attendance.date" styleClass="field-label"/>
        <DatePicker fx:id="datePicker" prefWidth="170"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="%attendance.allPresent" onAction="#handleAllPresent"/>
        <Button fx:id="saveButton" text="%btn.save" onAction="#handleSave" styleClass="btn-primary"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS" editable="true">
        <columns>
            <TableColumn fx:id="studentColumn" text="%attendance.student" prefWidth="260"/>
            <TableColumn fx:id="statusColumn" text="%attendance.status" prefWidth="180"/>
            <TableColumn fx:id="notesColumn" text="%attendance.notes" prefWidth="300"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
    </TableView>

    <Label fx:id="summaryLabel" styleClass="hint"/>
</VBox>
