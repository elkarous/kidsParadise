<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="550.0" prefWidth="420.0" spacing="15.0" style="-fx-background-color: #f4f9f4; -fx-padding: 30;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kids.ui.LoginController">

    <!-- 1. الشعار في أعلى الشاشة -->
    <ImageView fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true">
        <image>
            <!-- ضع مسار الصورة الفعلي هنا داخل مجلد الـ resources لديك -->
            <Image url="@/images/logo.jpg" />
        </image>
    </ImageView>

    <!-- 2. العناوين الرئيسية -->
    <Label text="روضة جنة الصغار" textFill="#2ecc71">
        <font>
            <Font name="System Bold" size="32.0" />
        </font>
    </Label>

    <Label text="تسجيل الدخول إلى حسابك" textFill="#7f8c8d">
        <font>
            <Font name="System Bold" size="13.0" />
        </font>
    </Label>

    <!-- 3. حاوية حقول الإدخال المنسقة (تضم الحقول والـ ComboBox) -->
    <VBox alignment="CENTER" spacing="12.0" style="-fx-padding: 10 0 10 0;">

        <TextField fx:id="usernameField" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="38.0" prefWidth="250.0" promptText="اسم المستخدم" style="-fx-background-radius: 8; -fx-padding: 5 10 5 10; -fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-radius: 8;">
            <font>
                <Font size="13.0" />
            </font>
        </TextField>

        <PasswordField fx:id="passwordField" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="38.0" prefWidth="250.0" promptText="كلمة المرور" style="-fx-background-radius: 8; -fx-padding: 5 10 5 10; -fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-radius: 8;">
            <font>
                <Font size="13.0" />
            </font>
        </PasswordField>

        <!-- قائمة اختيار السنة الدراسية المضافة والمحدثة استايلها -->
        <ComboBox fx:id="comboSchoolYear" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="38.0" prefWidth="250.0" promptText="اختر السنة الدراسية" style="-fx-background-radius: 8; -fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-radius: 8; -fx-padding: 2 5 2 5;" />

    </VBox>

    <!-- 4. زر تسجيل الدخول المتناسق تماماً مع حجم الحقول -->
    <Button fx:id="loginButton" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" onAction="#handleLogin" prefHeight="40.0" prefWidth="250.0" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold;" text="دخول" textAlignment="CENTER">
        <cursor>
            <Cursor fx:constant="HAND" />
        </cursor>
        <font>
            <Font size="14.0" />
        </font>
    </Button>

    <!-- 5. حقل إظهار الأخطاء -->
    <Label fx:id="errorLabel" textFill="#e74c3c">
        <font>
            <Font size="12.0" />
        </font>
    </Label>
</VBox>