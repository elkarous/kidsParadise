<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.kindererp.controller.StaffAttendanceListController" spacing="12">
    <padding>
        <Insets top="12"/>
    </padding>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nameColumn" text="%staff.name" prefWidth="220"/>
            <TableColumn fx:id="statusColumn" text="%attendance.status" prefWidth="170"/>
            <TableColumn fx:id="checkInColumn" text="%attendance.checkIn" prefWidth="110"/>
            <TableColumn fx:id="checkOutColumn" text="%attendance.checkOut" prefWidth="110"/>
            <TableColumn fx:id="sessionsColumn" text="%attendance.sessions" prefWidth="100"/>
            <TableColumn fx:id="notesColumn" text="%attendance.notes" prefWidth="240"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
    </TableView>

    <HBox styleClass="button-bar">
        <Label text="%staffAttendance.hint" styleClass="hint" HBox.hgrow="ALWAYS" maxWidth="Infinity" wrapText="true"/>
        <Button fx:id="saveButton" text="%btn.save" onAction="#handleSave" styleClass="btn-primary"/>
    </HBox>
</VBox>
